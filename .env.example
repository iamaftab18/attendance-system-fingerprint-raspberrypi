SECRET_KEY=change-me

# Gmail SMTP - use a Google Account App Password, not your normal password
# https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Attendance below this percentage triggers a parent notification email
ATTENDANCE_THRESHOLD=75
# How often (in days) each student's attendance is re-checked
ATTENDANCE_CHECK_INTERVAL_DAYS=30
